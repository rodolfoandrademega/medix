{
  "name": "medix-platform",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev:web": "npm run dev --workspace @medix/web",
    "dev:api": "npm run dev --workspace @medix/api",
    "build:web": "npm run build --workspace @medix/web",
    "build:api": "npm run build --workspace @medix/api",
    "build": "npm run build:api && npm run build:web"
  }
}
